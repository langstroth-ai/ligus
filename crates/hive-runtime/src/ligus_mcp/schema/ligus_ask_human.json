{
  "description": "Ask the chat's humans a question and wait for the answer. Your turn pauses until someone answers or the timeout passes.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "options": {
        "description": "Choices to offer",
        "items": {
          "maxLength": 200,
          "type": "string"
        },
        "maxItems": 6,
        "type": "array"
      },
      "question": {
        "description": "The question",
        "maxLength": 2000,
        "type": "string"
      },
      "timeoutSecs": {
        "maximum": 3600,
        "minimum": 10,
        "type": "integer"
      }
    },
    "required": [
      "question"
    ],
    "type": "object"
  },
  "name": "ligus_ask_human"
}
