  --json                   one JSON object on stdout
  -h, --help               this help

EXAMPLES
  ligus-local install-cli --version v0.1.0 --json
  ligus-local install-cli --from-source --bin-dir ~/.local/bin --json

ENVIRONMENT
  ligus-local --help lists the variables every command reads

