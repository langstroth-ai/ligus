EOF
  help_common_flags
  cat <<'EOF'

EXAMPLES
  ligus-local unit --role serve --data-dir ~/.ligus-serve
  ligus-local unit --role worker --data-dir ~/.ligus-worker --launchd

ENVIRONMENT
  ligus-local --help lists the variables every command reads

EXIT CODES
  0 printed   2 usage error, or a path or label with a line break   3 ligus CLI missing
  4 the desktop app's data dir
