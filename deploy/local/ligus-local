hc_configure() {
  cat <<'EOF'
NAME
  ligus-local configure - write the env file and the data dir (no secret values)

USAGE
  ligus-local configure --role serve|worker --data-dir DIR [--env-file FILE] [--listen ADDR]
                        [--label NAME] [--relay-url URL] [--secret-backend file|keychain|secret-service]
                        [--admit-to ligusaddr1:... [--admit-wait 15m]]
                        [--throwaway-workspace] [--force] [--json]

  Creates DIR (mode 0700) and the env file (mode 0600) with
  LIGUS_REQUIRE_SANDBOX=1. Without a workspace connection:
  - with --admit-to (the workspace's approval address; not a secret, an
    Admin's `ligus admit address` prints it) it admits the box by code
    match, as `ligus setup box --to` does: the box prints a code on stderr,
    the Admin's desktop or phone shows the same code, they approve with a
    passkey, and the box keeps the admission once it is on the workspace
    log. Nothing is pasted. A relay without the approval mailbox falls back
    to the paste steps below (exit 4, with the join request).
  - otherwise it exits 4 and prints the admission steps: with the env file
    loaded, `ligus admit request` prints the box's join request; an Admin
    approves it (desktop: workspace menu > Admit a box, or the phone) and
    sends back a code; `ligus admit redeem` keeps it.
  A box never joins with a person's invite (`ligus help box`).

FLAGS
  --listen ADDR            serve: loopback, LAN or tailnet address:port (default 127.0.0.1:8787);
                           worker: health address (default 127.0.0.1:8788). 0.0.0.0 and [::]
                           are refused (exit 4): exposure is a human decision
  --label NAME             host label other members see (default: <short hostname>-<role>)
  --relay-url URL          override the relay the admission names (http or https)
  --secret-backend B       file: owner-only files in the data dir; keychain; secret-service
                           (default: unset, the OS store; macOS keychain prompts need the human)
  --admit-to ADDRESS       admit the box by code match through this approval address
                           (ligusaddr1:...; default: print the paste steps)
  --admit-wait DURATION    how long --admit-to waits for an approver (90s, 15m, 1h; default 15m)
  --throwaway-workspace    a random workspace nobody else holds, for trials and tests only
                           (needs --relay-url)
  --force                  rewrite an existing env file (default: leave it unchanged)
EOF
  help_common_flags
  cat <<'EOF'

EXAMPLES
  ligus-local configure --role serve --data-dir ~/.ligus-serve --json
  ligus-local configure --role worker --data-dir ~/.ligus-worker --label shed --json
  ligus-local configure --role serve --data-dir ~/.ligus-serve --admit-to ligusaddr1:... --json
  ligus-local configure --role serve --data-dir /tmp/ligus-trial --throwaway-workspace \
    --relay-url http://127.0.0.1:8443 --secret-backend file --force --json

ENVIRONMENT
  ligus-local --help lists the variables every command reads

EXIT CODES
  0 configured and a workspace connection exists (with --admit-to: the box was admitted)
  1 --admit-to: the codes didn't match, the approver declined, the approval wasn't on the
    workspace log, or the relay didn't answer (nothing kept; read checks[].fix)
  2 usage error   3 ligus CLI missing
  4 stop for the human: no workspace connection yet (admission; with --admit-to: no approver
    in time, a stale address, or a relay without the approval mailbox), 0.0.0.0, or the
    desktop app's data dir
EOF
}

hc_start() {
  cat <<'EOF'
NAME
  ligus-local start - start ligus serve or ligus worker

USAGE
  ligus-local start --role serve|worker --data-dir DIR [--env-file FILE] [--systemd | --launchd] [--json]

  Default: a background process (pid and log, ligus-local-ROLE.log, in the
  data dir). Already running for this data dir: reports it, starts nothing.

FLAGS
  --systemd                Linux: install ~/.config/systemd/user/ligus-ROLE.service and
                           systemctl --user enable --now it (default: off)
  --launchd                macOS: install ~/Library/LaunchAgents/ai.ligus.ROLE[.LABEL].plist and
                           load it (starts at login, restarted if it exits; default: off).
                           Exclusive with --systemd
EOF
  help_common_flags
  cat <<'EOF'

EXAMPLES
  ligus-local start --role serve --data-dir ~/.ligus-serve --json
  ligus-local start --role serve --data-dir ~/.ligus-serve --systemd --json
  ligus-local start --role worker --data-dir ~/.ligus-worker --launchd --json

ENVIRONMENT
  ligus-local --help lists the variables every command reads

EXIT CODES
  0 running   1 it exited at once, or another box holds the launchd label (read the log named)
  2 usage error, or a path with a line break   3 ligus CLI or env file missing, --systemd off
  Linux, --launchd off macOS   4 no workspace connection (human step), or the desktop app's data dir
EOF
}

hc_unit() {
  cat <<'EOF'
NAME
  ligus-local unit - print the systemd unit (or LaunchAgent plist) start would install

USAGE
  ligus-local unit --role serve|worker --data-dir DIR [--env-file FILE] [--launchd]

  Writes nothing. Prints the unit text on stdout (never JSON; --json is
