#!/usr/bin/env bash
# ligus-local: run Ligus's headless processes on this machine (a laptop, a
# home server, a CI box), non-interactively, for a person or a coding agent.
#
#   ligus-local preflight  [--role serve|worker]   check this machine; changes nothing
#   ligus-local install-cli [--version vX.Y.Z] [--bin-dir DIR] [--from-source]
#   ligus-local configure  --role serve|worker     write the env file (no secrets)
#   ligus-local start      --role serve|worker     start in the background (or --systemd / --launchd)
#   ligus-local unit       --role serve|worker     print the systemd unit start --systemd installs
#                                                  (--launchd: the LaunchAgent plist)
#   ligus-local verify     --role serve|worker     process (or its systemd unit / LaunchAgent), health, sandbox (alias: status)
#   ligus-local stop       --role serve|worker     (--systemd / --launchd: also no start at login)
#   ligus-local uninstall  --role serve|worker [--delete-data]
#   ligus-local upgrade    --role serve|worker     upgrade the CLI (brew or the release), restart, verify
#
# Common flags: --data-dir DIR (required: this device's identity and event
# log) --env-file FILE --json. The desktop app is installed and first opened
# by the human (Homebrew cask ligus-app); see AGENTS.md. A box joins a real
# workspace only through a box admission (`ligus admit request`, an Admin
# approves it with a passkey, `ligus admit redeem`); never with a person's
# invite. The approval is the human step.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/../.." && pwd)
# shellcheck source=../lib/agent-common.sh
. "$ROOT/deploy/lib/agent-common.sh"
AC_TOOL=ligus-local
MARKER=.ligus-local

# ------------------------------------------------------------------- help
# `ligus-local --help` (everything), `ligus-local help <command>` and
# `ligus-local <command> --help` (one command). Help goes to stdout, exit 0.
# deploy/tests/agent-deploy-test.sh checks every command in the dispatcher
# at the bottom has a section here and every flag the parser takes is named.

help_common_flags() {
  cat <<'EOF'
  --role serve|worker      which process: ligus serve (the always-on home host) or ligus worker
  --data-dir DIR           this process's own data dir: its device identity and event log
                           (default: $LIGUS_DATA_DIR; required with --role; never the desktop
                           app's data dir; one data dir is one process)
  --env-file FILE          the env file configure writes and start reads
                           (default: ${XDG_CONFIG_HOME:-~/.config}/ligus-ROLE/ligus-ROLE.env);
                           if you pass one, pass the same one to every command
  --json                   print exactly one JSON object on stdout (schema ligus.agent-deploy.v1,
                           a profile of ligus.checks.v1: ligus help checks); progress always
                           goes to stderr
  --color WHEN             auto, always or never: colour [FAIL] and [WARN] on stderr (default
                           auto: only on a terminal, and never when NO_COLOR is set)
  -o, --output FORMAT      json (the same as --json) or text (the default)
  -q, --quiet              print only the checks that need attention (warn, FAIL) on stderr
  -h, --help               print this command's help and exit 0
  A flag's value is the next argument or follows an equals sign (--data-dir DIR or --data-dir=DIR).
EOF
}

help_see_also() {
  cat <<'EOF'
SEE ALSO
  ligus-local help <command>     one command's help (also: ligus-local <command> --help)
  ligus help box                 running ligus serve as an always-on box
  ligus help worker              ligus worker: extra capacity bound to a named host
  ligus help agents-guide        what an agent may do alone and what needs a human
  ligus help troubleshooting     when start, verify or the sandbox check fails
  ligus help security            the sandbox, keys and what never leaves the device
  ligus help env                 every environment variable ligus reads
  ligus help kubernetes          the same on a cluster: deploy/kubernetes/ligus-k8s
  deploy/completions/ (zsh and fish completions for ligus-k8s and ligus-local)
  AGENTS.md (repository root), .claude/skills/ligus-deploy-local/SKILL.md,
  deploy/ligus-serve/README.md
EOF
}

hc_preflight() {
  cat <<'EOF'
NAME
  ligus-local preflight - check this machine; changes nothing

USAGE
  ligus-local preflight [--role serve|worker --data-dir DIR] [--env-file FILE] [--listen ADDR] [--json]

  Without --role: the ligus CLI (0.1.0 or later), curl and the agent sandbox
  (measured with `ligus doctor --sandbox` in a scratch data dir). With --role: also the
  data dir, whether the listen address is free or exposed, and whether a
  workspace connection is configured.

FLAGS
  --listen ADDR            the address to check (default: the env file's, else 127.0.0.1:8787
                           for serve, 127.0.0.1:8788 for worker)
EOF
  help_common_flags
  cat <<'EOF'

EXAMPLES
  ligus-local preflight --json
  ligus-local preflight --role serve --data-dir ~/.ligus-serve --json

ENVIRONMENT
  ligus-local --help lists the variables every command reads

EXIT CODES
  0 ready (warnings allowed)   1 a check failed (no sandbox, port taken)   2 usage error
  3 ligus CLI or curl missing   4 listen address on every interface, or the desktop app's data dir
EOF
}

hc_install_cli() {
  cat <<'EOF'
NAME
  ligus-local install-cli - install the ligus CLI

USAGE
  ligus-local install-cli [--version vX.Y.Z] [--bin-dir DIR] [--from-source] [--json]

  Downloads a release with the repository's install.sh, or builds it with
  cargo (--from-source), into DIR.

FLAGS
  --version vX.Y.Z         the release to install (default: latest; not used with --from-source)
