# systemd *user* unit for `ligus serve` — the home host the Ligus iOS app talks to.
#
# Install (see README.md in this directory):
#   install -Dm644 ligus-serve.service ~/.config/systemd/user/ligus-serve.service
#   install -Dm600 ligus-serve.env.example ~/.config/ligus-serve/ligus-serve.env   # then edit it
#   systemctl --user daemon-reload
#   systemctl --user enable --now ligus-serve
#   sudo loginctl enable-linger "$USER"     # keep it running without a login session
#
# The API binds to the address in LIGUS_SERVE_LISTEN (the box's Tailscale IP),
# never 0.0.0.0. If tailscaled isn't up yet at boot, the bind fails and
# Restart=always retries until the address exists.

[Unit]
Description=Ligus home host (ligus serve) for the iOS app
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Secrets (workspace key, relay token, ntfy token, MCP tokens) live only here,
# mode 0600, never in the unit or the repo.
EnvironmentFile=%h/.config/ligus-serve/ligus-serve.env
ExecStart=%h/.local/bin/ligus serve
Restart=always
RestartSec=5
# Files it creates (token, state, worktrees) are private to the user.
UMask=0077
# With a setuid-root bwrap and unprivileged user namespaces off, this stops
# bwrap sandboxing agents; ligus-local start --systemd then writes
# NoNewPrivileges=no with the reason (docs: operate/ops/linux-sandbox, setuid-bwrap).
NoNewPrivileges=yes
PrivateTmp=yes
# SIGTERM lets a turn in flight finish for up to 15 s; a longer one is
# finished as "interrupted" on the next start (ask again to retry).
TimeoutStopSec=20

[Install]
WantedBy=default.target
